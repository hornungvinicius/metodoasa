# Método ASA: configuração para Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html

# Forçar HTTPS: descomente só depois que o SSL estiver ativo no hPanel
# (ou use a opção "Forçar HTTPS" do próprio hPanel e deixe isto comentado).
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # HTML sempre revalida, para atualizações aparecerem na hora
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS do site leva ?v=<hash> no HTML; bibliotecas e fonte não mudam
  <FilesMatch "\.(js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imagens: 30 dias
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
